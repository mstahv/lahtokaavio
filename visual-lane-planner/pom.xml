<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>in.virit.sb</groupId>
        <artifactId>viritin-addon-project-parent</artifactId>
        <version>0.0.10</version>
        <relativePath/>
    </parent>

    <groupId>fi.virit</groupId>
    <artifactId>visual-lane-planner</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>Visual Lane Planner</name>
    <packaging>jar</packaging>
    <description>A Gantt-style, drag-and-drop arrangement component for
        planning items into time-anchored lanes. Originally extracted from the
        Lähtökaavio orienteering planner; the add-on itself is domain-agnostic.</description>

    <properties>
        <!-- Override the parent's older defaults to match the Lähtökaavio app -->
        <vaadin.version>25.3.3</vaadin.version>
        <spring.boot.version>4.1.1</spring.boot.version>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <browserless.test.version>25.3.2</browserless.test.version>
        <playwright.version>1.63.0</playwright.version>
        <mopo.version>0.0.6</mopo.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>in.virit</groupId>
            <artifactId>viritin</artifactId>
            <version>3.9.1</version>
        </dependency>

        <!-- Test scope: dev/test UI + tests -->
        <dependency>
            <groupId>in.virit</groupId>
            <artifactId>mopo</artifactId>
            <version>${mopo.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>browserless-test-spring</artifactId>
            <version>${browserless.test.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>



    <build>
        <plugins>
            <!--
                Playwright tests live as *IT.java and are wired through failsafe
                so they run on `mvn verify` but not on the faster `mvn test`.
                Unit / browserless tests use the *Test suffix and stay in surefire.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
